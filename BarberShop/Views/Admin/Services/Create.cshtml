@model BarberShop.ViewModels.Admin.ServiceFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Novo Serviço";
}

<div class="auth-container" style="max-width: 580px; margin: 2rem auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 class="brand-title gold-text" style="font-size: 1.5rem;"><i class="bi bi-scissors"></i> Cadastrar Serviço</h2>
        <a asp-action="Index" class="btn-outline-gold" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary-errors" asp-validation-summary="All"></div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Name" class="form-label">Nome do Serviço</label>
            <input asp-for="Name" class="form-control" placeholder="Ex: Cabelo + Barboterapia" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">Descrição Comercial</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Detalhes dos procedimentos, benefícios e produtos inclusos..." required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
                <label asp-for="Price" class="form-label">Preço (R$)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.50" min="1" placeholder="50.00" required />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DurationMinutes" class="form-label">Duração (Minutos)</label>
                <input asp-for="DurationMinutes" class="form-control" type="number" step="5" min="5" placeholder="30" required />
                <span asp-validation-for="DurationMinutes" class="text-danger"></span>
            </div>
        </div>

        <div class="form-check" style="margin-top: 0.5rem;">
            <input asp-for="IsActive" type="checkbox" id="chkActive" />
            <label for="chkActive">Serviço ativo para novos agendamentos</label>
        </div>

        <button type="submit" class="btn-gold" style="width: 100%; justify-content: center; padding: 0.85rem; margin-top: 1.5rem;">
            <i class="bi bi-check2"></i> Salvar Serviço
        </button>
    </form>
</div>
